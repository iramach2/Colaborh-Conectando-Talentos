# Public app URL used in auth e-mails and redirects.
VITE_PUBLIC_SITE_URL="https://colaborh.com.br"

# Optional WebRTC ICE servers for the custom interview room.
# Use JSON. Add a TURN server in production for reliable calls on corporate/mobile networks.
# Example:
# VITE_INTERVIEW_ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'
VITE_INTERVIEW_ICE_SERVERS=''
