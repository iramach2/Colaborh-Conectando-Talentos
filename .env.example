# Supabase Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend endpoint that receives resume files and calls Gemini server-side.
# Do not expose GEMINI_API_KEY in Vite/client-side variables.
